  },
  "4": {
    "class_type": "SculptForgeExport",
    "inputs": {"mesh": ["3", 0], "format": "glb", "filename_prefix": "3d/SculptForge_teddy"},
    "_meta": {"title": "SculptForge Export"}
  }
}
